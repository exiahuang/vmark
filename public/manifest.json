{
  "manifest_version": 3,
  "name": "Vmark - Keyboard New Tab Manager",
  "version": "0.0.5",
  "description": "Lightning-fast, keyboard-driven tab navigation. Auto-organize tabs, manage favorites, and browse history effortlessly.",
  "permissions": [
    "tabs",
    "storage",
    "history",
    "bookmarks",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-vmark": {
      "suggested_key": {
        "default": "Ctrl+0"
      },
      "description": "Open Vmark"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}